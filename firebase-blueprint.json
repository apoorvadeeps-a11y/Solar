{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile in the SuryaCheck application",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SolarAssessment": {
      "title": "SolarAssessment",
      "description": "A saved rooftop solar suitability assessment record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "stateId": { "type": "string", "maxLength": 50 },
        "buildingType": { "type": "string", "maxLength": 50 },
        "roofType": { "type": "string", "maxLength": 50 },
        "roofCondition": { "type": "string", "maxLength": 50 },
        "totalRoofAreaSqFt": { "type": "number" },
        "usableAreaPercent": { "type": "number" },
        "effectiveUsableAreaSqFt": { "type": "number" },
        "shadingLevel": { "type": "string", "maxLength": 50 },
        "roofOrientation": { "type": "string", "maxLength": 50 },
        "monthlyUnitsKwh": { "type": "number" },
        "monthlyBillInr": { "type": "number" },
        "sanctionedLoadKw": { "type": "number" },
        "recommendedCapacityKw": { "type": "number" },
        "annualGenerationKwh": { "type": "number" },
        "pmSuryaGharSubsidyInr": { "type": "number" },
        "netInvestmentInr": { "type": "number" },
        "paybackPeriodYears": { "type": "number" },
        "co2OffsetTonnesAnnual": { "type": "number" },
        "outcome": { "type": "string", "maxLength": 50 },
        "outcomeLabel": { "type": "string", "maxLength": 100 },
        "suitabilityScore": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "userId",
        "title",
        "totalRoofAreaSqFt",
        "recommendedCapacityKw",
        "outcome",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores individual user profile data"
    },
    "/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/SolarAssessment" },
      "description": "Stores user solar suitability assessment records"
    }
  }
}
