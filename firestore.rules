rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidAssessment(data) {
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.stateId is string && data.stateId.size() <= 50
        && data.buildingType is string && data.buildingType.size() <= 50
        && data.roofType is string && data.roofType.size() <= 50
        && data.roofCondition is string && data.roofCondition.size() <= 50
        && data.totalRoofAreaSqFt is number && data.totalRoofAreaSqFt >= 50 && data.totalRoofAreaSqFt <= 20000
        && data.usableAreaPercent is number && data.usableAreaPercent >= 0 && data.usableAreaPercent <= 100
        && data.effectiveUsableAreaSqFt is number && data.effectiveUsableAreaSqFt >= 0
        && data.shadingLevel is string && data.shadingLevel.size() <= 50
        && data.roofOrientation is string && data.roofOrientation.size() <= 50
        && data.monthlyUnitsKwh is number && data.monthlyUnitsKwh >= 0
        && data.monthlyBillInr is number && data.monthlyBillInr >= 0
        && data.sanctionedLoadKw is number && data.sanctionedLoadKw >= 0
        && data.recommendedCapacityKw is number && data.recommendedCapacityKw >= 0
        && data.annualGenerationKwh is number && data.annualGenerationKwh >= 0
        && data.pmSuryaGharSubsidyInr is number && data.pmSuryaGharSubsidyInr >= 0
        && data.netInvestmentInr is number && data.netInvestmentInr >= 0
        && data.paybackPeriodYears is number
        && data.co2OffsetTonnesAnnual is number
        && data.outcome is string && data.outcome.size() <= 50
        && data.outcomeLabel is string && data.outcomeLabel.size() <= 100
        && data.suitabilityScore is number && data.suitabilityScore >= 0 && data.suitabilityScore <= 100
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt is string;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Solar Assessments collection
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(assessmentId)
        && isValidAssessment(incoming())
        && incoming().createdAt is string;

      allow update: if isSignedIn()
        && isValidId(assessmentId)
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && isValidAssessment(incoming());

      allow delete: if isSignedIn()
        && isValidId(assessmentId)
        && existing().userId == request.auth.uid;
    }
  }
}
